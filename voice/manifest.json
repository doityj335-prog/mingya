{
 "ij54n5": {
  "file": "ij54n5.mp3",
  "dur": 3.89,
  "text": "我们先想想：4乘几，会等于36？"
 },
 "gpwi1l": {
  "file": "gpwi1l.mp3",
  "dur": 4.6,
  "text": "提示：4的口诀里，哪一句的得数是36？"
 },
 "466m9c": {
  "file": "466m9c.mp3",
  "dur": 1.83,
  "text": "没关系，我们分一分看。"
 },
 "1t9cfgh": {
  "file": "1t9cfgh.mp3",
  "dur": 5.67,
  "text": "对啦！4乘9等于36，所以36除以4等于9。我们看看分出来是什么样子。"
 },
 "1lq4f78": {
  "file": "1lq4f78.mp3",
  "dur": 6.69,
  "text": "三十六颗糖，平均分给四个小朋友。一人一颗地发，发一轮要用四颗。"
 },
 "m661bf": {
  "file": "m661bf.mp3",
  "dur": 2.19,
  "text": "第一轮，每人一颗。"
 },
 "dasmgv": {
  "file": "dasmgv.mp3",
  "dur": 1.85,
  "text": "再发一轮，每人两颗。"
 },
 "7vxlgn": {
  "file": "7vxlgn.mp3",
  "dur": 2.04,
  "text": "就这样，一轮一轮地发……"
 },
 "zd2wy2": {
  "file": "zd2wy2.mp3",
  "dur": 5.3,
  "text": "已经发了六轮，每人六颗。还剩十二颗，还能再发几轮？"
 },
 "hclggp": {
  "file": "hclggp.mp3",
  "dur": 2.32,
  "text": "对啦！再发三轮，每人九颗。"
 },
 "g2trzl": {
  "file": "g2trzl.mp3",
  "dur": 2.64,
  "text": "我们一轮一轮发发看。点「再发一轮」。"
 },
 "tadi2e": {
  "file": "tadi2e.mp3",
  "dur": 3.0,
  "text": "发完了！每人九颗，一颗也没剩。"
 },
 "1ek1fum": {
  "file": "1ek1fum.mp3",
  "dur": 7.73,
  "text": "四个小朋友，每人九颗，正好三十六颗。4乘9等于36，所以36除以4等于9。"
 },
 "19qm9gb": {
  "file": "19qm9gb.mp3",
  "dur": 4.49,
  "text": "想不起来时，就先想：4乘几等于36。"
 },
 "73da1w": {
  "file": "73da1w.mp3",
  "dur": 6.35,
  "text": "换个办法：用4的口诀跳一跳。从0开始，每次跳四格。"
 },
 "1k5wpl5": {
  "file": "1k5wpl5.mp3",
  "dur": 2.04,
  "text": "跳到36，一共跳了几次？"
 },
 "1h0gunx": {
  "file": "1h0gunx.mp3",
  "dur": 3.68,
  "text": "对啦！跳了九次，36里面有九个4。"
 },
 "yb4hww": {
  "file": "yb4hww.mp3",
  "dur": 2.64,
  "text": "我们数一数：一共跳了九次。"
 },
 "2w1w3l": {
  "file": "2w1w3l.mp3",
  "dur": 5.15,
  "text": "三十六颗有点多，拆小一点：先分二十颗，再分十六颗。"
 },
 "roz8cb": {
  "file": "roz8cb.mp3",
  "dur": 2.3,
  "text": "先分二十颗，每人五颗。"
 },
 "vm8ua0": {
  "file": "vm8ua0.mp3",
  "dur": 2.48,
  "text": "再分十六颗，每人又多四颗。"
 },
 "sja458": {
  "file": "sja458.mp3",
  "dur": 2.4,
  "text": "5加4，每人一共几颗？"
 },
 "3efphb": {
  "file": "3efphb.mp3",
  "dur": 3.5,
  "text": "对啦！5加4等于9，每人九颗。"
 },
 "1c9y79r": {
  "file": "1c9y79r.mp3",
  "dur": 2.46,
  "text": "5加4等于9，每人九颗。"
 },
 "1ddqg38": {
  "file": "1ddqg38.mp3",
  "dur": 3.4,
  "text": "先看简单的：八颗糖，平均分给四个小朋友。"
 },
 "14ureyl": {
  "file": "14ureyl.mp3",
  "dur": 5.15,
  "text": "每人两颗，一样多。每人分得一样多，就叫平均分。"
 },
 "4tb41k": {
  "file": "4tb41k.mp3",
  "dur": 2.56,
  "text": "好，现在回到三十六颗糖。"
 },
 "16uipj3": {
  "file": "16uipj3.mp3",
  "dur": 5.12,
  "text": "这道题和刚才的很像。你来试试：28除以4等于几？"
 },
 "ucso11": {
  "file": "ucso11.mp3",
  "dur": 2.3,
  "text": "提示：4乘几等于28？"
 },
 "18qtve9": {
  "file": "18qtve9.mp3",
  "dur": 6.53,
  "text": "对啦！你先想到了4乘7等于28，用乘法来想除法，这个办法很好。"
 },
 "fdjsan": {
  "file": "fdjsan.mp3",
  "dur": 6.82,
  "text": "我们分一分看：二十八颗分给四个人，每人七颗。所以28除以4等于7。"
 },
 "5r6esx": {
  "file": "5r6esx.mp3",
  "dur": 5.54,
  "text": "4、8、12、16、20、24、28、32、36。"
 },
 "1grac8g": {
  "file": "1grac8g.mp3",
  "dur": 4.73,
  "text": "4乘8等于32，还不到36。没关系，我们分一分看。"
 },
 "1e8h19j": {
  "file": "1e8h19j.mp3",
  "dur": 5.07,
  "text": "4乘10等于40，比36多了。没关系，我们分一分看。"
 },
 "12pnxlq": {
  "file": "12pnxlq.mp3",
  "dur": 3.37,
  "text": "4乘5等于20，还不到28。再想一想？"
 },
 "13l2ya3": {
  "file": "13l2ya3.mp3",
  "dur": 4.0,
  "text": "4乘6等于24，还不到28。再想一想？"
 },
 "j46l4f": {
  "file": "j46l4f.mp3",
  "dur": 3.87,
  "text": "4乘8等于32，比28多了。再想一想？"
 }
}